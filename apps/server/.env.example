# Copy this file to .env for local development.
# NEVER commit your real .env or DATABASE_URL to GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Authentication policy
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_PHONE_VERIFICATION=false
REQUIRE_DEVICE_APPROVAL=false

# WebAuthn / Passkeys. For production these must match the public HTTPS origin.
WEBAUTHN_RP_NAME=Pro Chat
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Email delivery. Configure either SMTP_URL or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS.
SMTP_URL=
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio Verify for phone OTP. Create a Verify Service and keep secrets only in deployment secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
