# Copy this file to .env for local development.
# NEVER commit your real .env or DATABASE_URL to GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
HOST=0.0.0.0
PORT=3000
# Comma-separated production web origins are supported.
WEB_ORIGIN=http://localhost:5173
# Email/SMS providers are optional for core account creation and login.
# Add a recovery provider later for automated password reset delivery.
