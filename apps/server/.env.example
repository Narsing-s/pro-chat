# Copy this file to .env for local development.
# NEVER commit your real .env or DATABASE_URL to GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Transactional email is required for account verification and password recovery.
# Create a Resend API key and use a verified sender/domain in production.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Pro Chat <no-reply@your-domain.example>
